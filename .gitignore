# 依赖
node_modules/

# 构建产物
dist/
dist-electron/
out/
build-out/
release/
# 打包输出（固定 dist-pkg-current，见 tools/pack.mjs）
dist-pkg*/

# 日志与系统文件
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# 编辑器
.vscode/
.idea/

# UI 回归检查（Impeccable）：基线要提交，报告和个人覆盖配置不进库
.impeccable/reports/
.impeccable/config.local.json

# 预装运行时资源（由 tools/build-resources.mjs 重建，不入库）
# 含 onnxruntime wasm / tesseract / @imgly 抠图切片模型 / 卡证模型等，约 322MB。
# 全新克隆后执行 `node tools/build-resources.mjs --all` 即可重建，无需进版本库。
resources/

# 临时产物 / 一次性探针（.characterization 是基线，要提交）
.tmp/

# vite 加载配置时生成的临时文件（异常退出会残留）
vite.config.ts.timestamp-*.mjs

# 恢复/回退草稿与一次性快照（不入库）
.scratch/recovered/
.scratch/revert-backup/
.scratch/package.json.final

# E2E 测试运行产物（每次跑都重新生成，不入库）
tests/e2e/.out/
tests/e2e/_real_card_io/

# Python 字节码（曾误入库 3 个 .pyc，已 git rm --cached）
__pycache__/
*.pyc

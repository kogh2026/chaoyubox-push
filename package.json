{
  "name": "chaoyu-gongzuotai",
  "private": true,
  "version": "0.0.9",
  "type": "module",
  "description": "超誉工作台 — 桌面工具箱（批量打印 / 证卡拼版），Electron + Vite + React",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:atomic": "node electron/atomicWrite.check.cjs",
    "test:e2e": "python tests/e2e/run_all.py",
    "electron": "electron .",
    "electron:dev": "CHAOYU_DEV=1 electron .",
    "pack": "node tools/pack.mjs",
    "pack:fast": "node tools/pack.mjs --skip-build",
    "pack:clean": "node tools/pack.mjs --clean-only",
    "verify:packaged": "python tools/packaged_smoke_framing.py",
    "verify:packaged:persist": "python tools/packaged_options_persist.py",
    "verify:packaged:export": "python tools/packaged_export_smoke.py",
    "ui:check": "node tools/ui-regression.mjs",
    "ui:check:fast": "node tools/ui-regression.mjs --no-build",
    "ui:baseline": "node tools/ui-regression.mjs --no-build -u",
    "ui:report": "node tools/ui-regression.mjs --no-build --verbose",
    "typecheck": "tsc --noEmit",
    "ui:check:static": "node tools/ui-regression.mjs --static-only --no-build",
    "prepare": "husky",
    "verify:export": "python tools/export_characterization.py",
    "verify:dpi": "python tools/dpi_realcheck.py",
    "verify:framing": "python tools/framing_editor_smoke.py",
    "verify:persist": "python tools/options_persist_smoke.py",
    "verify:preview": "python tools/idphoto_preview_smoke.py",
    "verify:sheet": "python tools/photo_sheet_smoke.py",
    "verify:card": "python tools/card_detect_smoke.py",
    "verify:wiring": "node tools/panel-wiring.mjs"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@mediapipe/tasks-vision": "^1.2.0",
    "electron-updater": "^6.8.11",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "onnxruntime-web": "^1.21.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "husky": "^9.1.7",
    "impeccable": "^4.8.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.chaoyu.clone",
    "productName": "超誉工作台",
    "electronDist": "node_modules/electron/dist",
    "electronDownload": {
      "isVerifyChecksum": false
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/*.check.cjs"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "res",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "dist-pkg-current"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "超誉工作台"
    },
    "publish": {
      "provider": "generic",
      "url": "https://updates.example.com/chaoyu/"
    }
  }
}
